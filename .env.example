# Copy this file to .env and fill in values for your deployment.

# Port the server listens on. Render sets this automatically — you
# usually don't need to set it yourself in production.
PORT=4000

# Your deployed frontend's URL, so the API only accepts requests from
# your site (not required for local development).
# Example: FRONTEND_URL=https://masela.vercel.app
FRONTEND_URL=

# The public base URL of THIS backend, used to build full URLs for
# uploaded files (book photo, videos). Leave blank for local dev —
# relative /uploads/... URLs work fine there.
# Example: PUBLIC_URL=https://masela-api.onrender.com
PUBLIC_URL=

# Optional: where to store the SQLite database file and uploaded
# files. On Render, point this at your persistent disk's mount path
# (see README), e.g. /var/data
DB_DIR=
UPLOAD_DIR=
